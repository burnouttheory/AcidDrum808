<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
<meta http-equiv="Pragma" content="no-cache">
<meta http-equiv="Expires" content="0">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Acid Drum 808 V1.5.3 | Burnout Theory</title>
<link rel="stylesheet" href="style.css">
<link rel="stylesheet" href="acid808.css">
<link rel="stylesheet" href="acid808_v11.css">
</head>
<body>
<div class="app">

<!-- ============================================
     CONSOLIDATED TOP BAR
     ============================================ -->
<div class="compact-toolbar">
  <div class="toolbar-row-top">
    <div class="toolbar-left-menus">
      <div class="palette-add-buttons" id="fileMenuWrap" style="position:relative;">
        <button class="btn btn-refresh" id="fileMenuBtn">☰ File ▾</button>
        <div id="fileMenu" class="add-block-menu" style="display:none;">
          <button class="add-block-menu-item" id="exportSongBtn" data-tooltip="Export Song&#10;Exports the whole assembled song as one .mid file.">⇩ Export Song</button>
          <button class="add-block-menu-item" id="exportBlocksBtn" data-tooltip="Export All Blocks&#10;Exports every block (not just the open one) as its own .mid file — useful before you've built a full song sequence, or to edit parts elsewhere. The name you choose is used as a prefix for each file.">⇩ Export All Blocks</button>
          <div class="add-block-menu-sep"></div>
          <button class="add-block-menu-item" id="newProjectBtn" data-tooltip="New&#10;Starts a new, empty project. Discards the current one (with confirmation if there are unsaved changes).">🆕 New</button>
          <button class="add-block-menu-item" id="saveProjectBtn" data-tooltip="Save&#10;Saves the whole project — blocks, song sequence, settings — as a .json file.">💾 Save</button>
          <button class="add-block-menu-item" id="loadProjectBtn" data-tooltip="Load&#10;Loads a previously saved .json project file.">📂 Load</button>
        </div>
        <input type="file" id="loadProjectInput" accept="application/json,.json" style="display:none;">
      </div>

      <!-- Edit menu — Copy/Cut/Paste, Undo/Redo, Snap to Grid -->
      <div class="palette-add-buttons" id="editMenuWrap" style="position:relative;">
        <button class="btn btn-refresh" id="editMenuBtn">✎ Edit ▾</button>
        <div id="editMenu" class="add-block-menu" style="display:none;">
          <button class="add-block-menu-item" id="editSelectAllBtn" data-tooltip="Select All&#10;Selects every note in the current block (the locked groove-copy zone in a Break is excluded)."><span>▦ Select All</span><span class="menu-hotkey" data-hotkey="Ctrl+A"></span></button>
          <button class="add-block-menu-item" id="editSelectNoneBtn" data-tooltip="Select None&#10;Clears the current selection."><span>▢ Select None</span><span class="menu-hotkey" data-hotkey="Alt+A"></span></button>
          <button class="add-block-menu-item" id="editInvertSelectionBtn" data-tooltip="Invert Selection&#10;Selects every eligible note that isn't currently selected, and deselects the ones that are."><span>▥ Invert Selection</span><span class="menu-hotkey" data-hotkey="Ctrl+I"></span></button>
          <div class="add-block-menu-sep"></div>
          <button class="add-block-menu-item edit-menu-ne-only" id="editCopyBtn" data-tooltip="Copy&#10;Copies the selected note(s)."><span>⧉ Copy</span><span class="menu-hotkey" data-hotkey="Ctrl+C"></span></button>
          <button class="add-block-menu-item edit-menu-ne-only" id="editCutBtn" data-tooltip="Cut&#10;Cuts the selected note(s)."><span>✂ Cut</span><span class="menu-hotkey" data-hotkey="Ctrl+X"></span></button>
          <button class="add-block-menu-item edit-menu-ne-only" id="editPasteBtn" data-tooltip="Paste&#10;Pastes at the playhead."><span>📋 Paste</span><span class="menu-hotkey" data-hotkey="Ctrl+V"></span></button>
          <div class="add-block-menu-sep edit-menu-ne-only"></div>
          <button class="add-block-menu-item" id="undoBtn" disabled data-tooltip="Undo&#10;Nothing to undo."><span>↶ Undo</span><span class="menu-hotkey" data-hotkey="Ctrl+Z"></span></button>
          <button class="add-block-menu-item" id="redoBtn" disabled data-tooltip="Redo&#10;Nothing to redo."><span>↷ Redo</span><span class="menu-hotkey" data-hotkey="Ctrl+Shift+Z"></span></button>
          <div class="add-block-menu-sep edit-menu-ne-only"></div>
          <button class="add-block-menu-item edit-menu-ne-only" id="snapToGridBtn" data-tooltip="Snap to Grid&#10;Snaps the selected note(s) back onto the current grid. A post-processing tool on your Note Editor selection — does nothing without a selection.">🧲 Snap to Grid</button>
          <div class="add-block-menu-sep edit-menu-ne-only"></div>
          <div class="add-block-menu-item has-submenu edit-menu-ne-only">
            <span>🔓 Discard</span><span class="menu-hotkey">▸</span>
            <div class="add-block-menu submenu-flyout" id="discardSubmenu">
              <button class="add-block-menu-item" id="discardAllEditsBlockBtn" data-tooltip="All Edits (Block)&#10;Unlocks every manually-edited group in the current block (incl. Turnaround) — or, for a Break/Intro/Outro block, discards its hand-edited tail/fill — and hands it back to the knobs.">All Edits (Block)</button>
              <button class="add-block-menu-item" id="discardAllEditsGlobalBtn" data-tooltip="All Edits (Global)&#10;Same as above, but for every block in this project — regular blocks, Breaks, and Intro/Outro fills alike.">All Edits (Global)</button>
            </div>
          </div>
        </div>
      </div>

      <!-- + Add Block — only on Note Editor tab -->
      <div class="palette-add-buttons" id="addBlockMenuWrap" style="position:relative;">
        <button class="btn btn-refresh" id="addBlockBtn">+ Add Block ▾</button>
        <div id="addBlockMenu" class="add-block-menu" style="display:none;">
          <button class="add-block-menu-item" data-kind="empty" data-tooltip="Empty Block&#10;Blank, no notes.">Empty Block</button>
          <button class="add-block-menu-item" data-kind="intro" data-tooltip="Intro-style Fill&#10;Resolves into what follows.">Intro-style Fill</button>
          <button class="add-block-menu-item" data-kind="outro" data-tooltip="Outro-style Fill&#10;Sits at bar 1 and trails silent.">Outro-style Fill</button>
          <div class="add-block-menu-sep"></div>
          <button class="add-block-menu-item" data-kind="duplicate" data-tooltip="Duplicate Current&#10;A copy of whatever's open.">Duplicate Current</button>
          <div class="add-block-menu-sep"></div>
          <button class="add-block-menu-item" id="clearAllBlocksBtn" data-tooltip="Clear All&#10;Deletes every block (and removes them from the timeline of the Song Generator).">🗑 Clear All</button>
        </div>
      </div>

      <!-- Note Editor Options menu -->
      <div class="palette-add-buttons" id="neSettingsMenuWrap" style="position:relative;">
        <button class="btn btn-refresh" id="neSettingsBtn" data-tooltip="Options&#10;Note Editor settings.">Options ⚙</button>
        <div class="add-block-menu ne-settings-panel" id="neSettingsPanel" style="display:none;">
          <label class="gm-toggle" id="gmToggleLabel" data-tooltip="Show GM Notes&#10;Adds an editable MIDI/GM note-number field to every instrument row — lets you remap a track to a different sample/note without touching your DAW mapping."><input type="checkbox" id="gmNotesToggle"> Show GM Notes</label>
          <label class="gm-toggle" id="infoStringToggleLabel" data-tooltip="Show Info String&#10;Shows or hides the info strip above the grid (genre and feel, time signature and snap, number of blocks and notes, seed). Purely cosmetic."><input type="checkbox" id="infoStringToggle" checked> Show Info String</label>
          <label class="gm-toggle" id="showToolbarToggleLabel" data-tooltip="Show toolbar&#10;Shows or hides the generator controls: the group knobs, rerolls and pattern modes in the toolbar, Genre and Feel, and the Fill, Break and instrument settings in the sidebar. Snap, Time Signature, the block length and the selection tools (Quant, Swing, Rnd, Nudge) in the sidebar stay. Turn it off if you set your notes by hand."><input type="checkbox" id="showToolbarToggle" checked> Show toolbar</label>
          <div class="add-block-menu-sep"></div>
          <label class="gm-toggle" id="showConfirmDialogsToggleLabel" data-tooltip="Show confirmation dialogs&#10;Asks before actions that throw work away: discarding hand edits, rerolling all blocks, clearing all blocks or the timeline. Turn off to skip straight to the action."><input type="checkbox" id="showConfirmDialogsToggle"> Show confirmation dialogs</label>
          <div class="add-block-menu-sep"></div>
          <label class="gm-toggle" id="tooltipsToggleLabel" data-tooltip="Show tooltips&#10;Shows the hover tooltips across the whole app. Turn off if they get in the way."><input type="checkbox" id="tooltipsToggle" checked> Show tooltips</label>
          <div class="add-block-menu-sep"></div>
          <label class="gm-toggle" id="devToolsToggleLabel" data-tooltip="Developer tools&#10;Enables right-click Inspect for the web view (debugging). Leave off unless you need it."><input type="checkbox" id="devToolsToggle"> Developer tools</label>
          <div class="add-block-menu-sep"></div>
          <label class="gm-toggle" id="renderCachedToggleLabel" data-tooltip="Render cached samples&#10;On: exporting a song (offline render) plays the cached samples, exactly as in the DAW. Off: Hi-Hat, Ride and Cymbal are synthesised live from the physics model during the export - slower, but not limited by real time."><input type="checkbox" id="renderCachedToggle"> Render cached samples</label>
          <div class="add-block-menu-sep"></div>
          <label class="gm-toggle" id="a11yToggleLabel" data-tooltip="Accessible Zoom&#10;Enlarges a knob cluster under the cursor on hover — helps reading small controls."><input type="checkbox" id="a11yHoverZoomToggle"> Accessible Zoom</label>
          <label class="gm-toggle a11y-zoom-select-row" id="a11yZoomSelectLabel" data-tooltip="Zoom Factor&#10;How much larger a knob cluster gets under the cursor when Accessible Zoom is on.">
            <span class="a11y-zoom-select-indent"></span>
            <select id="a11yZoomFactorSelect" disabled>
              <option value="1">100%</option>
              <option value="1.25">125%</option>
              <option value="1.5" selected>150%</option>
              <option value="1.75">175%</option>
              <option value="2">200%</option>
              <option value="2.25">225%</option>
              <option value="2.5">250%</option>
              <option value="2.75">275%</option>
              <option value="3">300%</option>
            </select>
          </label>
          <div class="add-block-menu-sep"></div>
          <div class="add-block-menu-item has-submenu">
            <span>🔍 UI Scale</span><span class="menu-hotkey">▸</span>
            <div class="add-block-menu submenu-flyout" id="uiScaleSubmenu">
              <button class="add-block-menu-item" data-scale="0.75">75%</button>
              <button class="add-block-menu-item" data-scale="1" data-tooltip="100%&#10;The default UI scale.">100%</button>
              <button class="add-block-menu-item" data-scale="1.25">125%</button>
              <button class="add-block-menu-item" data-scale="1.5">150%</button>
              <button class="add-block-menu-item" data-scale="1.75">175%</button>
              <button class="add-block-menu-item" data-scale="2">200%</button>
            </div>
          </div>
        </div>
      </div>

      <!-- Generate Song — only on Song Generator tab -->
      <div class="palette-add-buttons" id="generateSongMenuWrap" style="position:relative; display:none;">
        <button class="btn btn-refresh" id="generateSongBtn">Generate Song ▾</button>
        <div id="generateSongMenu" class="add-block-menu" style="display:none;">
          <button class="add-block-menu-item" data-structure="12_bar_basic" data-tooltip="12 Bar Basic&#10;Intro → A A A A B B A B B B → Outro. A = 3× Verse + Verse Break, B = 3× Chorus + Chorus Break. Verse-heavy, blues-style repeat.">12 Bar Basic</button>
          <button class="add-block-menu-item" data-structure="aaa" data-tooltip="AAA&#10;Intro → A A A → Outro. A = 3× Verse + Verse Break. No Chorus or Bridge — the simplest structure, good for a steady groove or a quick sketch.">AAA</button>
          <button class="add-block-menu-item" data-structure="aaba_short" data-tooltip="AABA Short&#10;Intro → A A B A → Outro. A = 3× Verse + Verse Break, B = 3× Chorus + Chorus Break. Classic 32-bar shape: two Verses, a contrasting Chorus, back to the Verse.">AABA Short</button>
          <button class="add-block-menu-item" data-structure="aaba_long" data-tooltip="AABA Long&#10;Intro → A A B A A A B A → Outro. A = 3× Verse + Verse Break, B = 3× Chorus + Chorus Break. The AABA form repeated for a longer song.">AABA Long</button>
          <button class="add-block-menu-item" data-structure="abab_short" data-tooltip="ABAB Short&#10;Intro → A B A B → Outro. A = 3× Verse + Verse Break, B = 3× Chorus + Chorus Break. Alternating Verse and Chorus, no Bridge.">ABAB Short</button>
          <button class="add-block-menu-item" data-structure="abab_long" data-tooltip="ABAB Long&#10;Intro → A B A B A B A B → Outro. A = 3× Verse + Verse Break, B = 3× Chorus + Chorus Break. Alternating Verse and Chorus, doubled in length.">ABAB Long</button>
          <button class="add-block-menu-item" data-structure="abcabc_short" data-tooltip="ABCABC Short&#10;Intro → A B C A B C → Outro. A = 3× Verse + Verse Break, B = 3× Chorus + Chorus Break, C = 3× Bridge + Bridge Break. A full Verse / Chorus / Bridge cycle, repeated twice.">ABCABC Short</button>
          <button class="add-block-menu-item" data-structure="abcabc_long" data-tooltip="ABCABC Long&#10;Intro → (A B C) four times → Outro. A = 3× Verse + Verse Break, B = 3× Chorus + Chorus Break, C = 3× Bridge + Bridge Break. The cycle repeated four times, for an extended arrangement.">ABCABC Long</button>
          <button class="add-block-menu-item" data-structure="chorus_first" data-tooltip="Chorus First&#10;Intro → B A B C B → Outro. A = 3× Verse + Verse Break, B = 3× Chorus + Chorus Break, C = 3× Bridge + Bridge Break. Opens on the Chorus (the hook) before the first Verse.">Chorus First</button>
          <button class="add-block-menu-item" data-structure="standard_pop" data-tooltip="Standard Pop&#10;Intro → A B A B C B → Outro. A = 3× Verse + Verse Break, B = 3× Chorus + Chorus Break, C = 3× Bridge + Bridge Break. The common radio-pop shape: two Verse/Chorus pairs, a Bridge, then a final Chorus.">Standard Pop</button>
          <button class="add-block-menu-item" data-structure="extended_pop" data-tooltip="Extended Pop&#10;Intro → A B A B C B B → Outro. A = 3× Verse + Verse Break, B = 3× Chorus + Chorus Break, C = 3× Bridge + Bridge Break. Standard pop with a doubled closing Chorus.">Extended Pop</button>
          <div class="add-block-menu-sep"></div>
          <button class="add-block-menu-item" id="consolidateSongBtn" data-tooltip="Consolidate&#10;Closes every gap — shifts each clip left in order, right after the one before it, without changing their order.">↤ Consolidate</button>
          <div class="add-block-menu-sep"></div>
          <button class="add-block-menu-item" id="clearSongBtn" data-tooltip="Clear All&#10;Removes every clip from the timeline. Blocks themselves are untouched.">🗑 Clear All</button>
        </div>
      </div>

      <!-- Song Generator Options menu -->
      <div class="palette-add-buttons" id="tlOptionsMenuWrap" style="position:relative; display:none;">
        <button class="btn btn-refresh" id="tlOptionsMenuBtn" data-tooltip="Options&#10;Song Generator settings.">Options ⚙</button>
        <div id="tlOptionsMenu" class="add-block-menu" style="display:none;">
          <label class="gm-toggle" id="tooltipsToggleLabelSG" data-tooltip="Show tooltips&#10;Shows the hover tooltips across the whole app. Turn off if they get in the way."><input type="checkbox" id="tooltipsToggleSG" checked> Show tooltips</label>
          <div class="add-block-menu-sep"></div>
          <label class="gm-toggle" id="devToolsToggleLabelSG" data-tooltip="Developer tools&#10;Enables right-click Inspect for the web view (debugging). Leave off unless you need it."><input type="checkbox" id="devToolsToggleSG"> Developer tools</label>
          <div class="add-block-menu-sep"></div>
          <label class="gm-toggle" id="renderCachedToggleLabelSG" data-tooltip="Render cached samples&#10;On: exporting a song (offline render) plays the cached samples, exactly as in the DAW. Off: Hi-Hat, Ride and Cymbal are synthesised live from the physics model during the export - slower, but not limited by real time."><input type="checkbox" id="renderCachedToggleSG"> Render cached samples</label>
          <div class="add-block-menu-sep"></div>
          <label class="gm-toggle" id="a11yToggleLabelSG" data-tooltip="Accessible Zoom&#10;Enlarges a knob cluster under the cursor on hover — helps reading small controls."><input type="checkbox" id="a11yHoverZoomToggleSG"> Accessible Zoom</label>
          <label class="gm-toggle a11y-zoom-select-row" id="a11yZoomSelectLabelSG" data-tooltip="Zoom Factor&#10;How much larger a knob cluster gets under the cursor when Accessible Zoom is on.">
            <span class="a11y-zoom-select-indent"></span>
            <select id="a11yZoomFactorSelectSG" disabled>
              <option value="1">100%</option>
              <option value="1.25">125%</option>
              <option value="1.5" selected>150%</option>
              <option value="1.75">175%</option>
              <option value="2">200%</option>
              <option value="2.25">225%</option>
              <option value="2.5">250%</option>
              <option value="2.75">275%</option>
              <option value="3">300%</option>
            </select>
          </label>
          <div class="add-block-menu-sep"></div>
          <div class="add-block-menu-item has-submenu">
            <span>🔍 UI Scale</span><span class="menu-hotkey">▸</span>
            <div class="add-block-menu submenu-flyout" id="uiScaleSubmenu">
              <button class="add-block-menu-item" data-scale="0.75">75%</button>
              <button class="add-block-menu-item" data-scale="1" data-tooltip="100%&#10;The default UI scale.">100%</button>
              <button class="add-block-menu-item" data-scale="1.25">125%</button>
              <button class="add-block-menu-item" data-scale="1.5">150%</button>
              <button class="add-block-menu-item" data-scale="1.75">175%</button>
              <button class="add-block-menu-item" data-scale="2">200%</button>
            </div>
          </div>
        </div>
      </div>

      <!-- Drum Engine Options menu -->
      <div class="palette-add-buttons" id="deOptionsMenuWrap" style="position:relative; display:none;">
        <button class="btn btn-refresh" id="deOptionsMenuBtn" data-tooltip="Options&#10;Drum Engine settings.">Options ⚙</button>
        <div id="deOptionsMenu" class="add-block-menu" style="display:none;">
          <label class="gm-toggle de-retrigger-row" data-tooltip="Retrigger&#10;How often the Morph Pads and the knob preview repeat the sound while the mouse button is held, in milliseconds.">
            Retrigger (ms)
            <input type="number" id="deRetrigger" min="150" max="1000" step="50" value="450">
          </label>
          <div class="add-block-menu-sep"></div>
          <label class="gm-toggle" data-tooltip="Meter Peak Hold&#10;How long the peak marker and the peak value above the meter stay at the loudest level before they fall back, in seconds.">
            Meter Peak Hold
            <select id="dggMeterPeakHoldSelect">
              <option value="0.5">0.5 s</option>
              <option value="1">1 s</option>
              <option value="2" selected>2 s</option>
              <option value="5">5 s</option>
              <option value="10">10 s</option>
            </select>
          </label>
          <div class="add-block-menu-sep"></div>
          <label class="gm-toggle" id="deKnobPreviewToggleLabel" data-tooltip="Preview sound on knob turn&#10;Plays the instrument while you turn one of its knobs, repeating at the Retrigger rate as long as you hold it. Turn off if it's annoying.">
            <input type="checkbox" id="deKnobPreviewToggle"> Preview sound on knob turn
          </label>
          <div class="add-block-menu-sep"></div>
          <label class="gm-toggle" id="tooltipsToggleLabelDE" data-tooltip="Show tooltips&#10;Shows the hover tooltips across the whole app. Turn off if they get in the way."><input type="checkbox" id="tooltipsToggleDE" checked> Show tooltips</label>
          <div class="add-block-menu-sep"></div>
          <label class="gm-toggle" id="devToolsToggleLabelDE" data-tooltip="Developer tools&#10;Enables right-click Inspect for the web view (debugging). Leave off unless you need it."><input type="checkbox" id="devToolsToggleDE"> Developer tools</label>
          <div class="add-block-menu-sep"></div>
          <label class="gm-toggle" id="renderCachedToggleLabelDE" data-tooltip="Render cached samples&#10;On: exporting a song (offline render) plays the cached samples, exactly as in the DAW. Off: Hi-Hat, Ride and Cymbal are synthesised live from the physics model during the export - slower, but not limited by real time."><input type="checkbox" id="renderCachedToggleDE"> Render cached samples</label>
          <div class="add-block-menu-sep"></div>
          <label class="gm-toggle" id="a11yToggleLabelDE" data-tooltip="Accessible Zoom&#10;Enlarges a knob cluster under the cursor on hover — helps reading small controls."><input type="checkbox" id="a11yHoverZoomToggleDE"> Accessible Zoom</label>
          <label class="gm-toggle a11y-zoom-select-row" id="a11yZoomSelectLabelDE" data-tooltip="Zoom Factor&#10;How much larger a knob cluster gets under the cursor when Accessible Zoom is on.">
            <span class="a11y-zoom-select-indent"></span>
            <select id="a11yZoomFactorSelectDE" disabled>
              <option value="1">100%</option>
              <option value="1.25">125%</option>
              <option value="1.5" selected>150%</option>
              <option value="1.75">175%</option>
              <option value="2">200%</option>
              <option value="2.25">225%</option>
              <option value="2.5">250%</option>
              <option value="2.75">275%</option>
              <option value="3">300%</option>
            </select>
          </label>
          <div class="add-block-menu-sep"></div>
          <div class="add-block-menu-item has-submenu">
            <span>🔍 UI Scale</span><span class="menu-hotkey">▸</span>
            <div class="add-block-menu submenu-flyout" id="uiScaleSubmenu">
              <button class="add-block-menu-item" data-scale="0.75">75%</button>
              <button class="add-block-menu-item" data-scale="1" data-tooltip="100%&#10;The default UI scale.">100%</button>
              <button class="add-block-menu-item" data-scale="1.25">125%</button>
              <button class="add-block-menu-item" data-scale="1.5">150%</button>
              <button class="add-block-menu-item" data-scale="1.75">175%</button>
              <button class="add-block-menu-item" data-scale="2">200%</button>
            </div>
          </div>
        </div>
      </div>

      <!-- Drum Engine Cache panel (expert settings: baking can take a long time) -->
      <div class="palette-add-buttons" id="deCacheMenuWrap" style="position:relative; display:none;">
        <button class="btn btn-refresh" id="deCacheMenuBtn" data-tooltip="Cache&#10;Expert settings for the baked sound variants: how many variants per sound, and clearing the cache.">Cache 🗄</button>
        <div id="deCacheMenu" class="add-block-menu" style="display:none; min-width:280px;">
          <div class="de-cache-row" data-tooltip="Variants per sound&#10;How many independently baked recordings per sound setting are played back in rotation. This is the count currently in effect; it only changes once all samples for a new count are baked.">
            <span>Variants per sound</span><span class="de-cache-value" id="deCacheVariantCurrent">7</span>
          </div>
          <div class="de-cache-row" data-tooltip="Change variants&#10;Enter a new count (1-20) and press Apply. More variants = more sound variance, but longer bake time and more storage. Shows an estimate first; the new count takes effect when all its samples are baked.">
            <span>Change to</span>
            <span class="de-cache-edit">
              <input type="number" id="deCacheVariantInput" min="1" max="20" step="1" value="7">
              <button class="btn btn-sm btn-refresh" id="deCacheApplyBtn">Apply</button>
            </span>
          </div>
          <div id="deCacheBakeProgressRow" style="display:none; padding:6px 8px;">
            <div id="deCacheBakeProgressLabel" style="font-size:var(--fs-xl); font-weight:600; opacity:0.95; white-space:nowrap; margin-bottom:3px;"></div>
            <div style="width:100%; height:5px; background:var(--white-a15); border-radius:2px; overflow:hidden;">
              <div id="deCacheBakeProgressBar" style="height:100%; width:0%; background:var(--progress-fill); transition:width 0.15s linear;"></div>
            </div>
          </div>
          <div class="add-block-menu-sep"></div>
          <label class="gm-toggle" data-tooltip="Cache Size Limit&#10;Maximum disk space for baked sound variants (machine-wide, all projects). When it is exceeded, the least recently used sets are deleted; the factory defaults are never deleted.&#10;Lowering the limit deletes sets immediately if the cache is larger.">
            Size limit
            <select id="deCacheLimitSelect">
              <option value="2">2 GB</option>
              <option value="5" selected>5 GB</option>
