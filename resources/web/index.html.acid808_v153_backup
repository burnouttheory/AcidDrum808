                </div>
        </div>
    <div class="ne-grid-toolbar">
        <div class="ne-toolbar-corner">
          <button class="btn ne-add-track-btn" id="neAddTrackTopBtn" data-tooltip="Add Track&#10;Opens the setup dialog (instrument, GM note). On confirm the track is added under the instrument's name.">+ Add Track</button>
        </div>
        <div class="stat-pills" id="statPills"></div>
        <div class="ne-zoom-ctrl" data-tooltip="Zoom&#10;Zooms the note grid. Ctrl+scroll over the grid does the same.">
          <span class="ne-ctl-label">Zoom</span>
          <input type="range" id="neZoomSlider" class="ne-mini-slider" min="0" max="1" step="0.01" value="0.5">
          <span class="ne-mini-val" id="neZoomVal">100%</span>
          <button class="ne-barnav-btn" id="neZoomFitBtn" data-tooltip="Fit&#10;Hotkey F&#10;Fits the selected content into view. If nothing is selected, the whole content gets centered.">⤢</button>
        </div>
      </div>
      <div class="drum-grid" id="drumGrid"></div>
    </div>
    <div class="ne-sidebar-col">
      <button class="ne-sidebar-toggle" id="neSidebarToggle" data-tooltip="Sidebar&#10;Hotkey Tab&#10;Toggles the note-editor sidebar.">›</button>
      <div class="ne-sidebar-top">
      <div class="ne-sidebar-heading">Main</div>
      <div class="ctrl w-snap select-only" data-tooltip="Snap&#10;The Note Editor's snap grid — how finely hand-placed/dragged/painted notes snap to the beat. Independent from each instrument's Subdiv knob, which only affects generated patterns.">
          <div class="ctrl-label">Snap</div>
          <select id="subdivision">
            <optgroup label="Straight">
              <option value="2">8th</option>
              <option value="4" selected>16th</option>
              <option value="8">32nd</option>
              <option value="16">64th</option>
            </optgroup>
            <optgroup label="Triplet">
              <option value="3">8th Triplet</option>
              <option value="6">16th Triplet</option>
            </optgroup>
          </select>
        </div>
      <div class="ctrl w-genre select-only ne-gen-only" data-tooltip="Genre&#10;A starting point, not a lock-in — sets the time signature and a baseline Feel, and applies matching preset values to Verse/Chorus/Bridge. Everything it sets can be freely overridden afterward.">
          <div class="ctrl-label">Genre</div>
          <select id="genreSelect">
            <option value="straight" selected>Straight</option>
            <option value="three_four">3/4</option>
            <option value="swing">Swing</option>
          </select>
        </div>
      <div class="ctrl w-timesig select-only">
          <div class="ctrl-label">Time Signature</div>
          <div class="timesig-row">
            <select id="numerator" data-tooltip="Numerator&#10;Pulses per bar — the top number of the time signature.">
              <option value="2">2</option><option value="3">3</option>
              <option value="4" selected>4</option><option value="5">5</option>
              <option value="6">6</option><option value="7">7</option>
              <option value="8">8</option><option value="9">9</option>
              <option value="10">10</option><option value="11">11</option>
              <option value="12">12</option><option value="13">13</option>
              <option value="14">14</option><option value="15">15</option>
              <option value="16">16</option>
            </select>
            <span class="timesig-slash">/</span>
            <select id="denominator" data-tooltip="Denominator&#10;Note value of one pulse — the bottom number. Pure note-value scaling, not compound-time regrouping.">
              <option value="2">2</option>
              <option value="4" selected>4</option>
              <option value="8">8</option>
              <option value="16">16</option>
            </select>
          </div>
        </div>
    </div>
    <div class="ne-sidebar-top" id="neSelectedNotes">
      <div class="ne-sidebar-heading">Selected notes</div>
      <div class="ne-vel-mini-ctrl" data-tooltip="Quantize&#10;Pulls the selected note(s) toward the Snap grid by this strength: 100% puts them exactly on it (like Snap to Grid), lower values only tighten the timing. Applied on release, does nothing without a selection."><span class="ne-vel-mini-label">Quant</span><input type="range" class="ne-vel-mini-slider" id="quantizeAmt" min="0" max="100" value="0"><span class="ne-vel-mini-val" id="quantizeAmtVal">0%</span></div>
      <div class="ne-vel-mini-ctrl" data-tooltip="Swing&#10;Moves the off-beat notes of the selected note(s) by this share of a step: 0 leaves them alone, positive values delay them (swing), negative values push them ahead, +50% is a hard 3:1 swing. The step is the Snap step, or the first multiple of it at which your selection has off-beat notes (hi-hats on 8ths swing on the 8th off-beats even with a 16th Snap). Applied on release, each note keeps its own timing feel. Does nothing without a selection."><span class="ne-vel-mini-label">Swing</span><input type="range" class="ne-vel-mini-slider" id="swingAmt" min="-50" max="50" value="0"><span class="ne-vel-mini-val" id="swingAmtVal">0%</span></div>
      <div class="ne-vel-mini-ctrl" data-tooltip="Randomize&#10;Randomizes the selected note(s)' timing and velocity by this amount. A post-processing tool on your Note Editor selection, applied on release — does nothing without a selection."><span class="ne-vel-mini-label">Rnd</span><input type="range" class="ne-vel-mini-slider" id="randomizeAmt" min="0" max="100" value="0"><span class="ne-vel-mini-val" id="randomizeAmtVal">0%</span></div>
      <div class="ne-vel-mini-ctrl" id="nudgeCtrl" data-tooltip="Nudge&#10;Shifts the selected note(s) back or forward by 1/8 of the current Snap step per click — fine timing feel, independent of the Snap grid (not quantized). Select a note first."><span class="ne-vel-mini-label">Nudge</span><div class="ne-nudge-group"><button class="ne-barnav-btn" id="nudgeBackBtn" type="button">◀</button><span class="ne-vel-mini-val" id="nudgeVal">0</span><button class="ne-barnav-btn" id="nudgeFwdBtn" type="button">▶</button></div></div>
    </div><div class="ne-sidebar" id="neSidebar"></div>
    </div>
  </div>
</div>

