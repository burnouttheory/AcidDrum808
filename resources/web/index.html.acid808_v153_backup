<!-- ============================================
     DRUM ENGINE TAB
     ============================================ -->
<div class="tab-panel drum-engine-panel" data-tab-panel="drumEngine">
  <!-- The instrument sub-tabs (Kick/Snare/...) live in the transport row (#blockPaletteWrap's .transport-group). -->
  <div class="de-body">
    <!-- Polyphony and Accent are kit-wide engine settings, not per-instrument details. They sit in the left column of .de-lower
         (mirroring the output meter on the right) so nothing lies between the instrument tabs and the articulation selector. -->

    <div class="de-lower">
    <div id="dePolyRow">
        <div class="knob-cluster de-cluster">
          <div class="cluster-knobs">
            <div class="subgroup-unit-wrapper">
              <div class="subgroup-vertical-stack">
                <div class="cluster-title">Polyphony</div>
                <div style="display:flex; flex-direction:row; gap:6px; align-items:flex-end;">
                  <div class="ctrl" data-tooltip="Polyphony&#10;How many Kick hits can overlap at once before the oldest gets stolen.">
                    <div class="ctrl-label">Kick <span class="val" id="dePolyKickVal">2</span></div>
                    <input type="range" id="dePolyKick" min="1" max="4" step="1" value="2">
                  </div>
                  <div class="ctrl" data-tooltip="Polyphony&#10;How many Snare hits (incl. ghost notes/flams) can overlap at once.">
                    <div class="ctrl-label">Snare <span class="val" id="dePolySnareVal">4</span></div>
                    <input type="range" id="dePolySnare" min="1" max="8" step="1" value="4">
                  </div>
                  <div class="ctrl" data-tooltip="Polyphony&#10;How many Tom hits can overlap at once — applies to all five toms (Rack Tom 1–3, Floor Tom 1–2) together.">
                    <div class="ctrl-label">Tom <span class="val" id="dePolyTomVal">3</span></div>
                    <input type="range" id="dePolyTom" min="1" max="6" step="1" value="3">
                  </div>
                  <div class="ctrl" data-tooltip="Polyphony&#10;How many Ride articulations (Bow/Bell/Edge/Mute) can overlap at once.">
                    <div class="ctrl-label">Ride <span class="val" id="dePolyRideVal">3</span></div>
                    <input type="range" id="dePolyRide" min="1" max="6" step="1" value="3">
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="knob-cluster de-cluster" id="deAccentCluster">
          <div class="cluster-knobs">
            <div class="subgroup-unit-wrapper">
              <div class="subgroup-vertical-stack">
                <div class="cluster-title">Accent</div>
                <div style="display:flex; flex-direction:row; gap:6px; align-items:flex-end;">
                  <div class="ctrl" data-tooltip="Accent&#10;How hard an accented hit (a marker in the Accent lane of the Note Editor) drives the drum circuits. 0%: no difference, every hit plays as before. 100%: the full accent of the TR-808, a trigger of 14 V instead of the normal 4 V. Accented hits get louder and change in tone the way the circuit does (from about +4 dB for clap, maracas and PC-2 to about +14 dB for toms, rim shot and cymbal; hi-hats about +10 to +12 dB); normal hits stay as they are. Applies to all instruments (PC-2 reaches its maximum at about 25%). Accented hi-hat, cymbal and ride hits are baked into the cache the first time they are played at a new Accent setting; until then they are calculated live.">
                    <div class="ctrl-label">Amount <span class="val" id="deAccentAmountVal">0%</span></div>
                    <input type="range" id="deAccentAmount" min="0" max="100" step="1" value="0">
                  </div>
                  <button type="button" class="tab-btn" id="dePreviewAccent" aria-pressed="false" data-tooltip="Preview with accent&#10;On: everything you audition in the Drum Engine tab (keyboard, knob turns, morph pads) plays as an accented hit at the Accent amount. Off: it plays as a normal hit. Pattern playback is not affected, it uses the Accent lane.">Preview accent</button>
                </div>
              </div>
            </div>
          </div>
        </div>
    </div>
      <div class="de-main">
        <div class="de-param-panels" id="deParamPanels"></div>
      </div>

      <div class="de-side" id="deSide">
        <!-- Read-only peak value above the meter; driven by the meter itself
             (readoutEl, see db-meter.js) — hidden while no audio is playing. -->
        <div class="de-peak-row">
          <div class="de-peak-readout" id="dePeakReadout"></div>
        </div>
        <div id="deSideMeter"></div>
      </div>
    </div>
  </div>

  <div class="de-keyboard-wrap" id="deKeyboardWrap">
    <div class="de-keyboard" id="deKeyboard"></div>
  </div>
  <div class="de-legend" id="deLegend"></div>
</div>

