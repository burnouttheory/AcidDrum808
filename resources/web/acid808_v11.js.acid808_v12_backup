    ['snare',      'SNARE DRUM', 'snare'],
    ['tomLow',     'LOW TOM',    'tom'],
    ['tomMid',     'MID TOM',    'tom'],
    ['tomHi',      'HI TOM',     'tom'],
    ['snareRimShot','RIM SHOT',  'rim'],
    ['handClap808','HAND CLAP',  'clap'],
    ['cowbell808', 'COWBELL',    'bell'],
    ['crash1',     'CYMBAL',     'cymbal'],
    ['ohh',        'OPEN HAT',   'hat'],
    ['chh',        'CLSD HAT',   'hat'],
    ['accent',     'ACCENT',     'accent'],
