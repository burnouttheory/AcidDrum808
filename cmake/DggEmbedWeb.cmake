# Embeds every file of resources/web into a generated C++ source, so the plugin DLL carries its own web UI.
# The generated DggEmbeddedWebResource() is the lookup the WebView serves https://iplug.example/<name> from.
function(dgg_embed_web_resources out_cpp web_dir)
  file(GLOB files CONFIGURE_DEPENDS "${web_dir}/*")

  set(pair "[0-9a-f][0-9a-f]")
  set(chunk "")
  foreach(i RANGE 1 16)
    string(APPEND chunk "${pair}")
  endforeach()

  set(arrays "")
  set(entries "")
  set(idx 0)
  foreach(f ${files})
    if(IS_DIRECTORY "${f}")
      continue()
    endif()
    # Re-run configure (and so regenerate) whenever a web file changes.
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${f}")

    get_filename_component(name "${f}" NAME)
    get_filename_component(ext "${f}" EXT)
    string(TOLOWER "${ext}" ext)
    if(ext STREQUAL ".html")
      set(mime "text/html; charset=utf-8")
    elseif(ext STREQUAL ".js")
      set(mime "application/javascript; charset=utf-8")
    elseif(ext STREQUAL ".css")
      set(mime "text/css; charset=utf-8")
    elseif(ext STREQUAL ".json")
      set(mime "application/json")
    elseif(ext STREQUAL ".svg")
      set(mime "image/svg+xml")
    elseif(ext STREQUAL ".png")
      set(mime "image/png")
    elseif(ext STREQUAL ".jpg" OR ext STREQUAL ".jpeg")
      set(mime "image/jpeg")
    elseif(ext STREQUAL ".woff2")
      set(mime "font/woff2")
    elseif(ext STREQUAL ".woff")
      set(mime "font/woff")
    elseif(ext STREQUAL ".ttf")
      set(mime "font/ttf")
    else()
      set(mime "application/octet-stream")
    endif()

    file(READ "${f}" hex HEX)
    # 16 bytes per source line, each byte as 0xNN,
    string(REGEX REPLACE "(${chunk})" "\\1\n" hex "${hex}")
    string(REGEX REPLACE "(${pair})" "0x\\1," bytes "${hex}")
    string(APPEND arrays "static const unsigned char kDggWeb${idx}[] = {\n${bytes}0};\n")
    string(APPEND entries "  { \"${name}\", kDggWeb${idx}, sizeof(kDggWeb${idx}) - 1, \"${mime}\" },\n")
    math(EXPR idx "${idx} + 1")
  endforeach()

  set(content "// Generated by cmake/DggEmbedWeb.cmake -- do not edit.\n#include <cstddef>\n#include <cstring>\n\nnamespace {\n${arrays}\nstruct DggWebEntry { const char* name; const unsigned char* data; size_t size; const char* mime; };\nconst DggWebEntry kDggWebEntries[] = {\n${entries}};\n}\n\nbool DggEmbeddedWebResource(const char* path, const unsigned char** data, size_t* size, const char** mime)\n{\n  if (!path || !*path) path = \"index.html\";\n  for (const DggWebEntry& e : kDggWebEntries)\n  {\n    if (std::strcmp(e.name, path) == 0) { *data = e.data; *size = e.size; *mime = e.mime; return true; }\n  }\n  return false;\n}\n")

  set(tmp "${out_cpp}.tmp")
  file(WRITE "${tmp}" "${content}")
  execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${tmp}" "${out_cpp}")
endfunction()
